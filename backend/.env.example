ENV=development
DATABASE_URL=sqlite+aiosqlite:///./helm.db
# production: postgresql+asyncpg://user:pass@host/db
SECRET_KEY=change-me-long-random-string
SIGNER=local
# Required for superadmin access in production. Obtain the account ID from the owner's authenticated /auth/me
# response and configure it in the host's secret/config store; do not guess or publish it.
SUPERADMIN_USER_ID=
# The owner account's email. Superadmin binds only when BOTH this and SUPERADMIN_USER_ID match the signing-in
# account; either left empty or mismatched leaves the deployment without a superadmin.
SUPERADMIN_EMAIL=
# Forwarded client IP headers are ignored unless this contains provider-verified proxy CIDRs. Leave blank until
# the hosting provider publishes the exact ranges. Do not add guessed ranges.
TRUSTED_PROXY_CIDRS=
# production: SIGNER=turnkey and fill in the three values below
TURNKEY_ORG_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# One or more RPC URLs, comma-separated. Requests rotate across them; a rate-limited or failing one is rested
# (30s, or 10 min if its key is rejected) and the next is used. Detailed configuration is admin-only.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=KEY_1,https://mainnet.helius-rpc.com/?api-key=KEY_2
# Read-only GMGN token metrics (price, market cap, liquidity, holders). Create the key at https://gmgn.ai/ai:
# generate an Ed25519 key pair locally, upload the PUBLIC key there, and put the issued API key here.
# Market data needs only this API key — the Ed25519 private key is GMGN's request-signing key for its own
# swap routes and must NOT be placed in Helm. Server secret only; charts use GMGN's public embed, keyless.
# GMGN accepts IPv4 requests only. Verify after setup: python -m app.market_check --network solana --token <mint>
GMGN_API_KEY=
# Shared request budget, within your plan's quota (plans: ~5, ~20, ~50 req/s burst; token info weight 1).
# Market responses are cached for 60 seconds.
GMGN_REQUESTS_PER_MINUTE=30
# Official pump.fun fee transaction builder. The default is correct; override only for a documented compatible
# deployment. This is not a secret and never receives private keys.
PUMPFUN_AGENT_API_URL=https://fun-block.pump.fun
# Optional platform fee on sells, in basis points (500 = 5%). 0 disables it.
# Trading fee on buys and sells, in basis points (100 = 1%, max 500). Taken inside each trade transaction and
# shown in every preview. The fee wallet must already hold at least ~0.001 SOL so small fees can land in it.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_WALLET=
# Helm's 0x address for EVM chains (optional). Set as the commission receiver on Flap tax tokens, so Flap pays
# Helm its launchpad commission on them. Use a wallet you control; the same address works on BNB and Robinhood.
PLATFORM_FEE_WALLET_EVM=
# With PLATFORM_FEE_BPS set and PLATFORM_FEE_WALLET_EVM set, EVM trades routed through a DEX (KyberSwap) also
# charge the Helm fee, paid to PLATFORM_FEE_WALLET_EVM by the DEX router. Bonding-curve trades on EVM don't yet.
KYBER_CLIENT_ID=HelmTerminals
# Optional: Helm's share of LP rewards on Clanker tokens launched through Helm, paid to PLATFORM_FEE_WALLET_EVM
# (bps; 1000 = 10%, max 2000). 0 = creators keep 100%. Shown in every Clanker deploy preview.
CLANKER_PLATFORM_REWARD_BPS=0
# Public URL of this API. Pons stores the token image as a URL, served from here.
PUBLIC_API_URL=https://api.helmterminals.xyz
# Share of the fee paid on-chain to whoever referred the trader (2500 = 25% of the fee).
REFERRAL_SHARE_BPS=2500
REFERRAL_CODE_MAX_USES=1000
REFERRAL_MAX_CODES_PER_USER=10
# Production example: CORS_ORIGINS=https://helmterminals.xyz
CORS_ORIGINS=http://localhost:5173

# Telegram bot (leave BOT_API_KEY empty to disable the integration)
BOT_API_KEY=
TELEGRAM_BOT_USERNAME=
BOT_DAILY_BUY_LIMIT_SOL=5
# Comma-separated Telegram numeric account IDs that may link and use a bot session. Empty disables all bot sessions.
TELEGRAM_ALLOWED_USER_IDS=
# Actions that move assets out to an arbitrary address and therefore need a 2FA code
TFA_REQUIRED_KINDS=withdraw,send_tokens
# Only for the bot process:
TELEGRAM_BOT_TOKEN=
HELM_API_URL=http://localhost:8000
# Bags (bags.fm) launchpad. Get an API key at https://dev.bags.fm; without it Bags shows "Needs setup".
# One or more keys, comma-separated; rotated the same way.
BAGS_API_KEY=
# Optional Bags partner key (created once in the Bags dev dashboard). Bags then pays this wallet its partner
# share (25% by default) of the fees on every token launched through Helm.
BAGS_PARTNER_WALLET=
BAGS_PARTNER_CONFIG=
# Jupiter API key(s), free at https://developers.jup.ag/portal (comma-separated to rotate). Turns on Meteora DBC
# launches through Jupiter Studio.
JUPITER_API_KEY=
# EVM RPC URLs, one variable per chain, each a comma-separated list rotated like SOLANA_RPC_URL.
# Leave blank to use the chain's public endpoint (rate-limited; fine for testing). Before an endpoint is used,
# Helm checks its chain ID; a URL for the wrong chain is refused. Chain IDs: Base 8453, BNB 56, Ethereum 1,
# Robinhood Chain 4663.
# Providers that want the key in an x-api-key header (e.g. Tatum): add ?xApiKey=KEY to the URL and Helm
# sends it as the header, e.g. https://robinhood-mainnet.gateway.tatum.io?xApiKey=KEY
EVM_RPC_BASE=
EVM_RPC_BSC=
EVM_RPC_ETHEREUM=
# Robinhood's provider must allow eth_chainId, eth_getBalance and eth_call (USDG balanceOf).
# A plan that blocks eth_call cannot report USDG. Rate-limited endpoints honor their cooldown;
# configure sufficient read capacity rather than repeatedly forcing dashboard refreshes.
EVM_RPC_ROBINHOOD=
# Pons native creator-reward splitter. Leave off until independent review and factory deployment on chain 4663.
# The configured factory runtime must exactly match contracts/HelmPonsRewards.sol's checked-in build.
PONS_REWARDS_ENABLED=false
PONS_REWARDS_FACTORY=

# Jupiter swaps on Solana (wallets page). The lite endpoint needs no key and is rate-limited; for
# production volume set JUPITER_API_URL=https://api.jup.ag with a key from dev.jup.ag.
JUPITER_API_URL=
JUPITER_API_KEY=

# Cross-chain routes (USDC -> gas on any chain) via Relay. Key optional (higher rate limits: relay.link dashboard).
# ROUTE_FEE_BPS is Helm's fee per route (30 = 0.3%), paid by Relay as USDC to PLATFORM_FEE_WALLET_EVM; claim it at
# relay.link. Needs PLATFORM_FEE_WALLET_EVM set, otherwise routes carry no Helm fee.
RELAY_API_KEY=
ROUTE_FEE_BPS=30
# Scheduled-buy caps per chain in native coin (Solana uses AUTOMATION_MAX_BUDGET_SOL), across all active plans.
AUTOMATION_MAX_BUDGETS=base=2,ethereum=2,robinhood=2,bsc=10

# --- TRON, NEAR, Arc and TON (see app/chains/networks.py) ---------------------------------------------------------
# Which of these networks are on (comma-separated ids): tron, near, arc, ton, all mainnets. Leave empty to turn
# them all off.
EXTRA_NETWORKS=tron,near,arc,ton
# Kill switch: false turns every one of these networks off at once.
ALLOW_MAINNET_EXTRA_NETWORKS=true
# RPC / index endpoints. Blank uses the network's public default. Set only in server configuration; users can't
# choose endpoints. NEAR URLs may be a comma-separated list.
TRON_RPC_URL=
NEAR_RPC_URL=
ARC_RPC_URL=
TON_RPC_URL=
EXTRA_RPC_TIMEOUT_S=15
# Secrets: set in the host's secret store, never commit real values.
TRONGRID_API_KEY=
TONCENTER_API_KEY=
PINATA_JWT=
# Sites a wallet-ownership proof may name (TON Connect ton_proof, TronLink, EVM and NEAR sign-in messages).
# Default: helmterminals.xyz plus the hosts in CORS_ORIGINS.
TON_PROOF_DOMAINS=
