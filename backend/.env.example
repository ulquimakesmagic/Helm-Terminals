ENV=development
DATABASE_URL=sqlite+aiosqlite:///./helm.db
# production: postgresql+asyncpg://user:pass@host/db
SECRET_KEY=change-me-long-random-string
SIGNER=local
# production: SIGNER=turnkey and fill in the three values below
TURNKEY_ORG_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional platform fee on sells, in basis points (500 = 5%). 0 disables it.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_WALLET=
# Production example: CORS_ORIGINS=https://helmterminals.xyz
CORS_ORIGINS=http://localhost:5173

# Telegram bot (leave BOT_API_KEY empty to disable the integration)
BOT_API_KEY=
TELEGRAM_BOT_USERNAME=
BOT_DAILY_BUY_LIMIT_SOL=5
# Actions that move assets out to an arbitrary address and therefore need a 2FA code
TFA_REQUIRED_KINDS=withdraw,send_tokens
# Only for the bot process:
TELEGRAM_BOT_TOKEN=
HELM_API_URL=http://localhost:8000
